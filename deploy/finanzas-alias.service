# Servicio de usuario: publica finanzas.local por mDNS (avahi) con la IP actual del portátil.
# Necesita el paquete avahi-utils. Instalar con: make install-service
[Unit]
Description=Alias mDNS finanzas.local
After=default.target

[Service]
Type=simple
ExecStart=%h/Documents/finanzas-personales/deploy/publicar-alias.sh finanzas.local
Restart=always
RestartSec=10

[Install]
WantedBy=default.target
