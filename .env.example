# Copia este archivo a .env (ignorado por git) y cambia los valores.
# Los nombres antiguos FINANZAS_* siguen funcionando como respaldo.
BRAIN_PIN=1234
# Secreto para firmar la cookie de sesión. Genera uno con: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
BRAIN_SECRETO=cambia-esto
# Opcional: ruta de la base
# BRAIN_DB=data/finanzas.db
# Opcional: vault Life Brain (solo lectura) y carpeta de fotos
# BRAIN_VAULT=~/Documents/vault
# BRAIN_FOTOS=data/fotos
# Fase 4: escribe el registro de comidas en 00_Inbox/comidas del vault (única escritura permitida)
# BRAIN_ESCRIBIR_COMIDAS=1
# Sincroniza Garmin y Polar solo al levantar la app (una vez al día). 0 para apagarlo
# BRAIN_SINCRONIZAR_AL_ARRANCAR=1
